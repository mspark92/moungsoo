# Local development only. Copy to .env; never commit .env.
PORT=3000
# Set a private value of at least 24 characters to enable local admin login.
ADMIN_TOKEN=
# Optional: an approved Korea Law Open Data OC for live official API calls.
LAW_API_OC=
# Optional: 64 hex characters for testing the dedicated scheduled-update route.
LAW_UPDATE_SIGNING_KEY=
# Optional: 공공데이터포털 한국천문연구원 특일 정보 "일반 인증키(Decoding)". Skips the weekday update on public holidays.
HOLIDAY_API_KEY=
