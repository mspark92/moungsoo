{
  "name": "business-legal-tax-reference-hosted",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "collect:cases": "node --env-file-if-exists=.env scripts/collect-cases.mjs",
    "collect:laws": "node --env-file-if-exists=.env scripts/collect-laws.mjs",
    "deploy:cloudflare": "npm run build && npx -y wrangler@4 deploy --config cloudflare/wrangler.toml"
  },
  "engines": {
    "node": ">=24"
  }
}
